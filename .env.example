# Vorlage fuer Umgebungsvariablen.
# So benutzen: diese Datei nach ".env.local" kopieren und echte Werte eintragen.
#   cp .env.example .env.local
# ".env.local" wird NIEMALS committet (siehe .gitignore) -> hier gehoeren echte Keys rein.

# --- Firebase Client-Config (oeffentlich, landet im Browser -> NEXT_PUBLIC_) ---
# Zu finden in der Firebase Console -> Projekteinstellungen -> "Meine Apps" -> Web-App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-only Secrets (NIE mit NEXT_PUBLIC_ praefixen -> bleiben serverseitig) ---
# Gemini API-Key: https://aistudio.google.com/apikey
# (in einem Projekt MIT aktiver Abrechnung erstellen, siehe docs/phase-3-belege.md)
GEMINI_API_KEY=
# Optional, Standard im Code: gemini-3.8-flash
GEMINI_MODEL=
# Wer die Belegauslesung (/api/receipts/parse) nutzen darf, Komma-getrennt.
# Server-only und VERBINDLICH: leer -> API antwortet 503.
ALLOWED_EMAILS=

# Erlaubte E-Mails (Komma-getrennt) - wer darf sich einloggen (du + Eltern)
# NEXT_PUBLIC_, weil die App schon im Browser pruefen muss, wer rein darf (UX).
# Die VERBINDLICHE Sperre kommt zusaetzlich ueber die Firestore Security Rules (Phase 2).
NEXT_PUBLIC_ALLOWED_EMAILS=
